<?xml version="1.0" encoding="utf-8"?>
<!--
    Quy tắc sao lưu (Android 12+). Dữ liệu thật nằm trên Firestore nên không cần sao lưu:
    - database: cache Room (tự đồng bộ lại từ server)
    - sharedpref: id nhắc nhở đang chạy, không được khôi phục sang máy khác
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
